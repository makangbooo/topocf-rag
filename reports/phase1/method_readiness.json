  "interpretation": {
    "why_t1_t2_are_not_primary": "their labels are recoverable from explicit reachability/canonical topology, so they measure graph parsing rather than semantic binding",
    "why_t3_is_primary": "positive and negative match canonical typed topology and every node's per-relation directed degree; the signal is document-node binding",
    "why_training_is_bounded": "the synthetic T3 split supports development, but the all-observed HotpotQA confirmatory split is below the preregistered sample minimum"
  },
  "method": {
    "claim": "question-conditioned document-node binding and evidence repair under matched typed topology",
    "name": "TopoCF-Bind-Repair-v1",
    "permutation_protocol": {
      "dev_and_test": "average the candidate score over all 24 document-alias permutations before ranking",
      "train": "sample one deterministic epoch-dependent S4 permutation per matched pair and apply it identically to the positive and negative members",
      "unit_of_invariance": "question, immutable document texts, and typed edges are relabeled together",
      "why": "prevents sequence position or neutral alias from becoming a label shortcut"
    },
    "training_objective": {
      "counterfactual_ranking": "paired margin loss: score(question, positive binding) > score(question, target-swapped binding)",
      "forbidden_training_examples": "T1, T2, fork, double-collider, natural retrieval errors, dev, and all-observed confirmatory pairs",
      "structured_repair": "predict the two mention-edge endpoints that restore the positive binding from the counterfactual candidate",
      "total": "ranking_loss + lambda_repair * repair_loss; lambda selected on train-only inner validation"
    }
  },
